                "#sdmlist = lambda pp, ses : preproc_filenames(join(output_dir, prefix(pp, ses)),\n",
                "#                                            sbref = 2, slicor = True, motcor = True,\n",
                "#                                            hpfil = False, tpsmo = False, topup = False, dtype = 'sdm')                          \n",
                "#sbrefsdms = lambda pp, ses : preproc_filenames(join(output_dir, prefix(pp, ses)),\n",
                "#                                            sbref = 3, slicor = False, motcor = True,\n",
                "#                                            hpfil = False, tpsmo = False, topup = False, dtype = 'sdm')\n",
                "#\n",
                "## we can now continue where we left of, and add the steps we still want to do: apply motion parameters and highpass filter\n",
