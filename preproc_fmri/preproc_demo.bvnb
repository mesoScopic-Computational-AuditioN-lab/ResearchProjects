                "\n",
                "###############################################\n",
                "## [CASE: ADVANCES INTER SESSION ALLIGNMENT] ##\n",
                "###############################################\n",
                "## the above case might be far from optimal, instead we can do some processing on both sessions (slicetime and 3d motion)\n",
                "## then generate a mean image over some volumes, and allign these to the other session\n",
                "## afterwards we can continue preprocessing after the slicetime step: applying the previous motion correction parameters again, but adding inter slice xyz's \n",
                "#\n",
                "#from bv_preproc.utils import preproc_filenames\n",
                "#\n",
                "## do the complete preprocessing of first session\n",
                "#bv_preproc.functional.preprocess_fmrs(bv, output_dir, pps, [1], process_sbreff=True)\n",
                "## do only partial preprocessing of second session (only slicetimecor and motion correction)\n",
                "#bv_preproc.functional.preprocess_fmrs(bv, output_dir, pps, [2], process_sbreff=True, b_hghp=False, b_temps=False)\n",
                "#\n",
                "## then allign session 2 to session 1 - by creating a mean volume of 2 runs and alligning them\n",
                "## this approach creates a sdm file that contains inter session rotations and translations\n",
                "#fromses = 2\n",
                "#toses = 1\n",
                "#meanovervols = 15\n",
                "#bv_preproc.functional.interses_files_create(bv, output_dir, [3], sess, meanovervols=meanovervols)\n",
                "#bv_preproc.functional.interses_files_allign(bv, output_dir, [3], fromses, toses)\n",
                "#\n",
