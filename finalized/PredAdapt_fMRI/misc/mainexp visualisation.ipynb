   "source": [
    "## for DREX figure\n",
    "\n",
    "from scipy.stats import norm\n",
    "\n",
    "blocknr = 1 \n",
    "octvspace = True\n",
    "lenback = 144#144\n",
    "\n",
    "\n",
    "# where block is 1\n",
    "idxblock = np.where(mat['timingz'][1] == blocknr) \n",
    "idxblock = idxblock[0][-lenback:]\n",
    "\n",
    "# get frequency presentation data for block\n",
    "frequencies = stimuli['pres_freq'][blocknr-1, :]\n",
    "frequencies = frequencies[-lenback:]\n",
    "\n",
    "# other values\n",
    "tps = np.sum(mat['timingz'][3, idxblock] == 9)  # get trials per section\n",
    "\n",
    "# get timings back from mat file, subtract begin time\n",
    "timings = mat['timingz'][4, idxblock] - np.min(mat['timingz'][4, idxblock]) \n",
    "\n",
    "# Create a condition for the block number\n",
    "block_condition = (mat['segmentz'][1] == blocknr)\n",
    "\n",
    "# Create a condition for values being 9 or 10 in mat['segmentz'][2]\n",
    "value_condition = (mat['segmentz'][2] == 9) | (mat['segmentz'][2] == 10)\n",
    "\n",
    "# Combine the conditions using np.where\n",
    "matidx = np.where(block_condition & value_condition)\n",
    "\n",
    "centa = 2**np.repeat(mat['segmentz'][7][matidx], tps)   # cent freq a\n",
    "centb = 2**np.repeat(mat['segmentz'][8][matidx], tps)   # cent freq b\n",
    "proba = np.repeat(mat['segmentz'][5][matidx], tps)      # prob a\n",
