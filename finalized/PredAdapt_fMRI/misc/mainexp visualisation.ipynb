   "source": [
    "## was in stim_moddeling notebook (for dependencies)\n",
    "\n",
    "from scipy.stats import norm\n",
    "\n",
    "color1 = '#2C7DFF' #- #5b8e7d\n",
    "color2 = '#FF3030'#- #bc4b51\n",
    "\n",
    "\n",
    "blocknr = 1 \n",
    "octvspace = True\n",
    "\n",
    "# where block is 1\n",
    "idxblock = np.where(mat['timingz'][1] == blocknr) \n",
    "\n",
    "# get frequency presentation data for block\n",
    "frequencies = stimuli['pres_freq'][blocknr-1, :]\n",
    "\n",
    "# other values\n",
    "tps = np.sum(mat['timingz'][3, idxblock] == 1)  # get trials per section\n",
    "\n",
    "# get timings back from mat file, subtract begin time\n",
    "timings = mat['timingz'][4, idxblock] - np.min(mat['timingz'][4, idxblock]) \n",
    "\n",
    "matidx = np.where(mat['segmentz'][1] == blocknr)\n",
    "\n",
    "centa = 2**np.repeat(mat['segmentz'][7][matidx], tps)   # cent freq a\n",
    "centb = 2**np.repeat(mat['segmentz'][8][matidx], tps)   # cent freq b\n",
    "proba = np.repeat(mat['segmentz'][5][matidx], tps)      # prob a\n",
    "probb = np.repeat(mat['segmentz'][6][matidx], tps)      # prob b\n",
    "\n",
    "# ACTUAL PLOTTING\n",
    "fig, ax = plt.subplots(2, \n",
    "                       1, \n",
    "                       sharex=True,\n",
    "                       gridspec_kw={'height_ratios': [3, 1]}, figsize=(10, 7.5))\n",
    "\n",
    "# octave transform if wanted\n",
    "if octvspace: \n",
    "    frequencies = np.log2(frequencies)\n",
    "    centa = np.log2(centa)\n",
    "    centb = np.log2(centb)\n",
    "\n",
    "# Top plot\n",
    "scatter = ax[0].scatter(timings, frequencies, color='grey', s=50)  # dots remain log-scaled\n",
    "ax[0].tick_params(axis='x', which='major', labelsize=20)           # set tick sizes x \n",
    "ax[0].tick_params(axis='y', which='major', labelsize=20)           # and y\n",
    "\n",
    "# Adjust y-axis to show Hz values (2**log_freq)\n",
    "yticks = ax[0].get_yticks()  # Get the current y-axis ticks (log scale)\n",
    "ytick_labels = [f\"{2**ytick:.0f}\" for ytick in yticks]  # Convert ticks to Hz\n",
    "ax[0].set_yticks(yticks)\n",
    "ax[0].set_yticklabels(ytick_labels)  # Update tick labels\n",
    "ax[0].set_ylabel('Frequency (Hz)', fontsize=24)\n",
    "\n",
    "\n",
    "# Ensure timings and probb are 1-dimensional\n",
    "timings = np.squeeze(timings)\n",
    "probb = 1-np.squeeze(probb)\n",
    "\n",
    "# Check if lengths match\n",
    "if len(timings) != len(probb):\n",
    "    raise ValueError(\"Timings and probabilities must have the same length.\")\n",
    "\n",
    "# Fill the lower plot with no outline\n",
    "ax[1].fill_between(timings, probb, 1, color=color1, alpha=0.9, edgecolor='none', label='Probb (upper)')\n",
    "ax[1].fill_between(timings, 0, probb, color=color2, alpha=0.9, edgecolor='none', label='Probb (lower)')\n",
    "\n",
    "ax[1].tick_params(axis='x', which='major', labelsize=20)                              # set tick sizes x \n",
    "ax[1].tick_params(axis='y', which='major', labelsize=20)                              # and y\n",
    "ax[1].set_xlabel('Time (seconds)', fontsize=24)\n",
    "ax[1].set_ylabel('Prob.', fontsize=24)\n",
    "\n",
    "# Format y-axis ticks of the second subplot to show percentages\n",
    "prob_ticks = ax[1].get_yticks()  # Get current y-axis ticks (e.g., 0, 0.5, 1)\n",
    "prob_tick_labels = [f\"{int(tick * 100)}%\" for tick in prob_ticks]  # Convert to percentages\n",
    "ax[1].set_yticks(prob_ticks)\n",
    "ax[1].set_yticklabels(prob_tick_labels)  # Update the tick labels\n",
    "ax[1].set_ylim(0, 1)\n",
    "\n",
    "# Calculate tighter y-limits\n",
    "y_min, y_max = np.min(frequencies), np.max(frequencies)\n",
    "y_padding = 0.1 * (y_max - y_min)  # Add a small padding\n",
    "y_min, y_max = y_min - y_padding, y_max + y_padding\n",
    "\n",
    "# Calculate tighter x-limits\n",
    "x_min, x_max = -1.0, np.max(timings)\n",
    "x_padding = 0.02 * (x_max - x_min)  # Add a small padding\n",
    "x_min, x_max = x_min, x_max + x_padding\n",
    "\n",
    "# Apply limits\n",
    "ax[0].set_ylim(y_min, y_max)\n",
    "ax[0].set_xlim(x_min, x_max)\n",
    "\n",
    "# Customizing borders\n",
    "for spine in ['top', 'right']:  # Remove upper and right borders\n",
    "    ax[0].spines[spine].set_visible(False)\n",
    "    ax[1].spines[spine].set_visible(False)\n",
    "\n",
    "for spine in ['left', 'bottom']:  # Thicken lower and left borders\n",
    "    ax[0].spines[spine].set_linewidth(4)\n",
    "    ax[1].spines[spine].set_linewidth(4)\n",
    "\n",
    "# Ensure the second plot follows the same x-limits\n",
    "ax[1].set_xlim(x_min, x_max)\n",
    "\n",
    "\n",
    "\n",
    "# ax[0].axhline(y=centa[0], color='darkred', linestyle='-', alpha=0.5, ls='--', lw=4)\n",
    "# ax[0].axhline(y=centb[0], color='darkred', linestyle='-', alpha=0.5, ls='--', lw=4)\n",
    "\n",
    "\n",
    "from scipy.stats import norm\n",
    "\n",
    "# Parameters for the Gaussians\n",
    "sigma = 0.333333\n",
    "\n",
    "# Generate x-values for the Gaussian\n",
    "y_gaussian = np.linspace(-3 * sigma, 3 * sigma, 500)  # Covers ±3σ range\n",
    "gaussian = norm.pdf(y_gaussian, loc=0, scale=sigma)  # Generate Gaussian curve\n",
    "\n",
    "# Normalize the Gaussian height to fit visually beside the plot\n",
    "gaussian = gaussian / max(gaussian) * (y_max - y_min) * 3   # Scale to 10% of y-range\n",
    "\n",
    "# Add Gaussian A beside the top subplot\n",
    "ax[0].plot(gaussian + x_max - 1, y_gaussian + centa[0], color=color2, lw=4)\n",
    "\n",
    "# Add Gaussian B beside the top subplot\n",
    "ax[0].plot(gaussian + x_max - 1, y_gaussian + centb[0], color=color1, lw=4)\n",
    "\n",
    "# # Adjust the x-limits to accommodate the Gaussians\n",
    "ax[0].set_xlim(x_min, x_max + max(gaussian))  # Extend x_max to fit the Gaussians\n",
    "ax[0].spines['bottom'].set_bounds(x_min, x_max)\n",
    "ax[1].spines['bottom'].set_bounds(x_min, x_max)\n",
    "\n",
    "# Save the plot as SVG and PDF\n",
    "# fig.savefig('main_design.svg', format='svg', bbox_inches='tight')\n",
    "fig.savefig('main_design.pdf', format='pdf', bbox_inches='tight')\n",
    "\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n"
   ]
  },
